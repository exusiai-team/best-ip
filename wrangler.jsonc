{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "best-ip",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  // 线上页面的静态根（scripts/verify_deploy.mjs 以这一行为比对基准）。
  "assets": {
    "directory": "./frontend-next",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
